  "narrative": {
    "northStar": "The Refined Studio Portfolio",
    "overview": "Calm editorial composition gives Nourelhak a personal typographic identity while genuine product screens provide the visual evidence. Deep green ink, warm neutral paper, and an italic serif create character through proportion and contrast.\n\nThe interface stays open and lightly ruled. Native scrolling, manual project navigation, and quiet responses keep the work easy to explore in English and French, in light and dark themes. This records the completed direction A rebuild, replacing the retired violet portrait system.",
    "keyCharacteristics": [
      "Open editorial composition with generous gutters.",
      "Manrope structure paired with expressive Instrument Serif.",
      "Real project screenshots and restrained image depth.",
      "Manual interaction, visible focus, and reduced-motion support."
    ],
    "rules": [
      {
        "name": "The Theme Roles Rule",
        "body": "Use the existing semantic CSS variables for shared surfaces and controls so both theme mappings remain coherent.",
        "section": "colors"
      },
      {
        "name": "The Two Voices Rule",
        "body": "Keep prose and controls in Manrope; reserve Instrument Serif for editorial headings and deliberate emphasis.",
        "section": "typography"
      },
      {
        "name": "The Screen Depth Rule",
        "body": "Keep the established image shadow attached to product imagery; preserve the flat treatment of prose and project rows.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do preserve semantic theme roles and readable contrast in both themes.",
      "Do use real public project screenshots with recorded provenance.",
      "Do retain native scrolling, manual carousel control, and reduced-motion behavior.",
      "Do keep English and French content complete when extending the site.",
      "Do use rules and open space to organize prose and project lists."
    ],
    "donts": [
      "Don't reintroduce the retired generated portrait, violet lighting, or artificial loading stage.",
      "Don't replace project evidence with fabricated metrics or decorative product mockups.",
      "Don't introduce autoplay into the manual project stage.",
      "Don't turn the open editorial layout into a repetitive card grid."
    ]
  }
